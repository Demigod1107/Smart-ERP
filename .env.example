# ====================================================================
# SMART SCHOOL — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# Note: Sensitive secrets are automatically masked in the admin UI.
# ====================================================================

# --------------------------------------------------------------------
# 1. Server & Security Settings
# --------------------------------------------------------------------
PORT=3000
NODE_ENV=production
JWT_SECRET=replace_this_with_a_secure_random_64_character_string

# --------------------------------------------------------------------
# 2. Database Configuration
# --------------------------------------------------------------------
# Path to SQLite database file (defaults to ./server/smart_school.db)
DB_PATH=./server/smart_school.db

# --------------------------------------------------------------------
# 3. Email Gateway Configuration (Nodemailer / SMTP / SendGrid / Gmail)
# --------------------------------------------------------------------
# Provider options: smtp | gmail | sendgrid
SMTP_PROVIDER=smtp
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@your-school-domain.com
SMTP_PASS=your_smtp_password_or_token
SMTP_FROM="Smart School Notifications <notifications@your-school-domain.com>"

# If using SendGrid API directly:
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# --------------------------------------------------------------------
# 4. SMS Gateway Configuration (Twilio)
# --------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+1234567890

# --------------------------------------------------------------------
# 5. Geolocation Attendance Boundaries (Optional)
# --------------------------------------------------------------------
CAMPUS_LATITUDE=28.6139
CAMPUS_LONGITUDE=77.2090
CAMPUS_RADIUS_METERS=150

